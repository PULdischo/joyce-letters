<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title or "James Joyce Letters (POC)" }}</title>
<style>
  body { font-family: Georgia, serif; max-width: 42rem; margin: 2rem auto; padding: 0 1rem; line-height: 1.6; color: #222; }
  header { border-bottom: 2px solid #35424b; margin-bottom: 2rem; padding-bottom: 0.5rem; }
  header a { color: #35424b; text-decoration: none; font-weight: bold; }
  nav a { margin-right: 1rem; font-family: sans-serif; font-size: 0.9rem; }
  h1 { font-size: 1.6rem; }
  .meta { font-family: sans-serif; font-size: 0.85rem; color: #555; background: #f0f0f0; padding: 0.75rem 1rem; border-radius: 4px; margin-bottom: 1.5rem; }
  .meta dt { font-weight: bold; display: inline; }
  .meta dd { display: inline; margin: 0 1rem 0 0.3rem; }
  a { color: #538c6c; }
  blockquote { border-left: 3px solid #ccc; margin-left: 0; padding-left: 1rem; color: #444; }
  u { text-decoration: underline; }
  hr { border: none; border-top: 1px solid #ccc; margin: 2rem 0; }
  .footnotes, [id^="fn"] { font-size: 0.9rem; }
  .conversion-note { font-family: sans-serif; font-size: 0.8rem; background: #fff8e1; border: 1px solid #e6d68a; padding: 0.5rem 1rem; border-radius: 4px; margin-top: 2rem; }
  ul.entry-list { list-style: none; padding: 0; }
  ul.entry-list li { padding: 0.4rem 0; border-bottom: 1px solid #eee; }
</style>
</head>
<body>
<header>
  <a href="/">James Joyce Letters — POC</a>
  <nav>
    <a href="/letters/">Letters</a>
    <a href="/people/">People</a>
    <a href="/places/">Places</a>
    <a href="/works/">Works</a>
    <a href="/search/">Search</a>
  </nav>
</header>
<main>
{{ content | safe }}
</main>
</body>
</html>
