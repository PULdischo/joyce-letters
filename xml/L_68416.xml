   <text>
      <body>
         <div type="letter">
                <gap reason="published in LII 407-8"/>
                <lb/>
                <div type="appendix">
                    <p>[first invoice]</p>
               <table rows="13" cols="2">
                  <row>
                            <cell>
                                <seg xml:id="seg1" type="note-anchor">A/C</seg>
                            </cell>
                        </row>
                  <row>
                            <cell>1 doz copies <hi rend="underline">A Portrait of the Artist as a Young Man</hi>
                            </cell>
                        </row>
                  <row>
                            <cell>@ 3/6</cell>
                            <cell rend="align-right">£2.2.0</cell>
                        </row>
                  <row>
                            <cell>carriage on 13 copies of same @ 4d</cell>
                            <cell style="padding-right: 1em; text-align: right; border-bottom: solid">4.4</cell>
                        </row>
                  <row>
                            <cell/>
                            <cell rend="align-right">£2.6.4</cell>
                        </row>            
                  <row>
                            <cell>less 1 copy of <hi rend="underline">Dubliners</hi>
                            </cell>
                        </row>
                  <row>
                            <cell>signed</cell>
                            <cell rend="align-right">10.6</cell>
                        </row>
                  <row>
                            <cell>less 1000 copies of <hi rend="underline">Press</hi>
                            </cell>
                        </row>
                  <row>
                            <cell>
                                <hi rend="underline">Notices</hi> @ 2fr. 50 per 100</cell>
                        </row>
                  <row>
                            <cell>(25 frs @ 22.00 = £1)</cell>
                        </row>
                  <row>
                            <cell/>
                            <cell style="padding-right: 1em; text-align: right; border-bottom: solid">£1.2.8</cell>
                        </row>
                  <row>
                            <cell/>
                            <cell style="padding-right: 1em; text-align: right; border-bottom: 4px double">13/2</cell>
                        </row>
               </table>
            </div>
                <lb/>
                <div type="appendix">
                    <p>[second invoice]</p>
                    <p>Received from <hi rend="underline">The</hi> <hi rend="underline">Egoist, Ltd</hi>
                    </p>
                    <p xml:space="preserve">        	£25.0.0</p>
                    <p>payment in advance of serial rights for <hi rend="underline">Ulysses</hi>
                    </p>
                    <closer>
                        <dateline>                                                        	<name type="geo" key="G_CHE_LOCA">Locarno</name> <date when="1917-10-19">19.x.917</date>
                        </dateline>
                        <signed>                                                                    	<name type="person" key="joyc82">James Joyce</name>
                        </signed> </closer>
                </div> <lb/>
                <div type="appendix">
                    <p>[third invoice]</p>
                    <p>Red. from <hi rend="underline">The</hi> <hi rend="underline">Egoist</hi>, <hi rend="underline">Ltd</hi>
                    </p>
                    <p xml:space="preserve">        	139 frs. 70 c.</p>
                    <p>payment of royalties on copies of <hi rend="underline">A</hi> <hi rend="underline">Portrait</hi> <hi rend="underline">of</hi> <hi rend="underline">the</hi> <hi rend="underline">Artist</hi>
                    </p>
                    <p>
                        <hi rend="underline">as</hi> <hi rend="underline">a</hi> <hi rend="underline">Young</hi> <hi rend="underline">Man</hi> sold up to <date when="1917-09-30">30/ix/917</date>
                    </p>
                    <closer>
                        <dateline>                                                        	<name type="geo" key="G_CHE_LOCA">Locarno</name> <date when="1917-10-19">19.x.917</date>
                        </dateline>
                        <signed>                                                                    	<name type="person" key="joyc82">James Joyce</name>
                        </signed>
                    </closer>
                </div>
            </div>
            <div type="notes">
                <note xml:id="global-note1" type="global">This is a transcription of 3 invoices written on 3 separate pieces of paper.</note>
                <note xml:id="note1" target="#seg1" type="commentary">Account/current (referring to a balance).</note>
            </div>
      </body>
   </text>
