   <text>
      <body>
         <div type="letter">
                <div type="mainBody">
                    <p>Dear <name type="person" key="weav76">Miss Weaver</name>: I forgot to say in my letter that I should like you to send a copy of <seg xml:id="seg1" type="note-anchor">
                            <rs type="work" key="W_APORTRAIT">my novel</rs>
                        </seg> (any edition) to:</p> <p xml:space="preserve">        	<name type="person" key="fere58">Mr Théophile Charles Féret</name></p>
                    <p xml:space="preserve">        	        	rue Saint Augustin 22,</p>
                    <p xml:space="preserve">                    	        	Paris</p>           <closer>
                        <salute>sincerely yours</salute>
                        <signed>
                            <name type="person" key="joyc82">                    	James Joyce</name>
                        </signed>
                    </closer>
                </div>
            </div>
            <div type="notes">
                <note xml:id="note1" target="#seg1" type="commentary">
                    <name type="work" key="W_APORTRAIT">A Portrait of the Artist as a Young Man</name>.</note>
            </div>
      </body>
