   <text>
      <body>
         <div type="letter">
                <div type="mainBody">
                    <dateline>
                        <date when="1917-08-23">23/8/917</date>
                    </dateline> <p>Dear <name type="person" key="weav76">Miss Weaver</name>: Excuse this primitive message which is to wish you many happy returns of your birthday. I was brought <seg xml:id="seg1" type="note-anchor">here</seg> two days ago and am to be operated this morning. Please continue to write to my old address.</p>
                    <closer>
                        <salute>        	With kind regards</salute>
                        <salute>                    	sincerely yours</salute>
                        <signed>
                            <name type="person" key="joyc82">                                	James Joyce</name>
                        </signed>
                    </closer>
                </div>
            </div>
            <div type="notes">
                <note xml:id="note1" target="#seg1" type="commentary">The Zurich Augenklinik (eye clinic) on Rämistrasse 73.</note>
            </div>
      </body>
   </text>
