   <text>
      <body>
         <div type="letter">
                <div type="address">
                    <ab>
                        <address>
                            <addrLine>
                                <name type="person" key="gads84">John Gadsby</name> C.B.E. esq.</addrLine>
                            <addrLine>Building 13</addrLine>
                            <addrLine>№12 Marunouchi-2-Chome</addrLine>
                            <addrLine>Kojimachi-Ku Tokyo</addrLine>
                        </address>
                    </ab>
                </div>
                <div type="mainBody">
                    <opener>
                        <dateline>c/o <name type="person" key="leon93">Mr Paul Léon</name>
                            <lb/>
                            <name type="geo" key="G_FRA_PARI">Paris</name>, <date when="1934-01-22">
                                <choice>
                                    <sic>january</sic>
                                    <corr>January</corr>
                                </choice> the 22nd 1934</date>
                        </dateline>
                        <salute>
                            <choice>
                                <sic>Dea</sic>
                                <corr>Dear</corr>
                            </choice> Sir,</salute>
                    </opener>
                    <p>I beg to authorise you herewith to deal and terminate the matter concerning the <choice>
                            <sic>japanese</sic>
                            <corr>Japanese</corr>
                        </choice> translation of my work entitled <name type="work" key="W_ULYSSES">ULYSSES</name> and to receive all moneys in this connection and deliver the necessary <choice>
                            <sic>recipts</sic>
                            <corr>receipts</corr>
                        </choice> and give the necessary authorisations in my name.</p>
                    <closer>
                        <salute>Believe me</salute>
                        <salute>sincerely yours</salute>
                    </closer>
                </div>
            </div>
            <div type="notes">
                <note xml:id="global-note1" type="global">This letter has been transcribed from a typed carbon copy.</note>
            </div>
      </body>
