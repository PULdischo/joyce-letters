   <text>
      <body>
         <div type="letter">
                <div type="mainBody">
                    <p>Dear <name type="person" key="weav76">Miss Weaver</name>: I hoped to be able to send you a copy of my play <hi rend="underline">
                            <name type="work" key="W_EXILES">Exiles</name>
                        </hi> for your birthday.  As <seg xml:id="seg1" type="note-anchor">
                            <rs type="person" key="hueb76">my publisher</rs>
                        </seg> has not yet sent the copies I beg you to accept my best wishes for many happy returns.</p> <p>
                        <seg type="published" function="context">
                            <quote>I sent the eighth episode of <hi rend="underline">
                                    <name type="work" key="W_ULYSSES">Ulysses</name>
                                </hi> (Eolus) to Mr Pound some days [ago] and hope you have it now.</quote>
                            <bibl>LI 118-9</bibl>
                        </seg>
                    </p>
                </div>
            </div>
            <div type="notes">
                <note xml:id="note1" target="#seg1" type="commentary">
                    <name type="person" key="hueb76">B. W. Huebsch</name>
                </note>
            </div>
      </body>
