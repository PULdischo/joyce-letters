   <text>
      <body>
         <div type="letter">
                <div type="address">
                    <ab>
                        <address>
                            <addrLine rend="printed">
                                <name type="geo" key="G_FRA_PARI_16">2, SQUARE ROBIAC</name>
                            </addrLine>
                            <addrLine rend="printed">192, RUE DE GRENELLE</addrLine>
                            <addrLine>Tel: Ségur 95-20</addrLine>
                        </address>
                    </ab>
                </div>
                <div type="mainBody">
                    <p>Dear <name type="person" key="budg82">Budgen</name>: Please call here today at 5.30 or, if prevented, ring me up.</p>
                    <closer>
                        <salute>sincerely yours</salute>
                        <signed>
                            <name type="person" key="joyc82">James Joyce</name>
                        </signed>
                        <dateline>
                            <date when="1927-12-17">
                                <seg xml:id="seg1" type="note-anchor">Saturday</seg>
                            </date>
                        </dateline>
                    </closer>
                </div>
            </div>
            <div type="notes">
                <note xml:id="note1" target="#seg1" type="commentary">This pneumatique sent on “Saturday” follows closely on the one sent on 14 December (Wednesday), in which JJ asked Budgen to telephone him on Thursday or Friday (<name type="work" key="ID_MISSING">LIII</name> 167).</note>
            </div>
      </body>
